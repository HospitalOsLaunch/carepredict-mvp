 def require_valid_preregistration(directory: Path) -> PreregistrationValidation:
     """Validate and raise before any training code may run."""
     result = validate_preregistration(directory)
     if not result.valid:
         raise PreregistrationError("; ".join(result.errors))
     return result
 
 
 def _validate_spec(document: Mapping[str, Any]) -> list[str]:
     errors: list[str] = []
     if document.get("status") not in {"PARTIAL_PREREGISTRATION", "PREREGISTRATION_FROZEN"}:
         errors.append("spec status must be partial or frozen preregistration")
     if not isinstance(document.get("main_runs_authorized"), bool):
         errors.append("spec main_runs_authorized must be boolean")
     families = document.get("primary_families")
     if not isinstance(families, dict) or families.get("maximum_count") != 3:
         errors.append("spec must freeze a maximum of three primary families")
     elif not isinstance(families.get("candidates"), list) or len(families["candidates"]) != 3:
         errors.append("spec must define exactly three primary candidates")
     actions = document.get("actions")
     if not isinstance(actions, dict) or actions.get("status") != (
         "ACTION_CONDITIONING_NOT_IDENTIFIABLE"
     ):
         errors.append("spec action branch must remain non-identifiable")
     foundation = document.get("foundation")
     if not isinstance(foundation, dict) or foundation.get("status") != (
         "FOUNDATION_EVIDENCE_INSUFFICIENT"
     ):
         errors.append("spec Foundation evidence status must remain insufficient")
     return errors
 
 
 def _validate_rights(document: Mapping[str, Any]) -> list[str]:
     try:
         registry = DataRightsRegistry.from_dict(cast(JSONValue, document))
     except ContractValidationError as exc:
         return [f"invalid data-rights registry: {exc}"]
     if registry.default_decision.value != "denied":
         return ["data-rights registry must remain deny-by-default"]
     return []
 
 
