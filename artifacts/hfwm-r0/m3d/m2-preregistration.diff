 def _validate_splits(document: Mapping[str, Any]) -> list[str]:
     errors: list[str] = []
     if document.get("split_before_windowing") is not True:
         errors.append("split_before_windowing must be true")
     if document.get("hierarchy") != [
         "organization",
         "site",
         "unit",
         "episode",
         "time",
         "window",
     ]:
         errors.append("split hierarchy must be organization/site/unit/episode/time/window")
     fractions = document.get("temporal_fractions")
     if not isinstance(fractions, dict):
         errors.append("temporal_fractions must be an object")
     else:
         values = [fractions.get(key) for key in ("train", "validation", "test")]
         if not all(isinstance(value, (int, float)) and value > 0 for value in values):
             errors.append("all temporal split fractions must be positive")
         else:
             numeric_values = [float(value) for value in values if isinstance(value, (int, float))]
             if abs(sum(numeric_values) - 1.0) > 1e-12:
                 errors.append("temporal split fractions must sum to 1")
     if document.get("correction_policy") != "INDIVISIBLE_FAMILY":
         errors.append("corrections must form indivisible split families")
     if document.get("cross_split_near_duplicates") != "FORBIDDEN":
         errors.append("cross-split near duplicates must be forbidden")
     return errors
 
 
 def _validate_metrics(document: Mapping[str, Any]) -> list[str]:
     errors: list[str] = []
     if document.get("results_status") != "NOT_EXECUTED":
         errors.append("metrics preregistration must not contain results")
     horizons = document.get("horizons_hours")
     if horizons != [6, 24, 72]:
         errors.append("primary horizons must be frozen to 6, 24 and 72 hours")
     primary = document.get("primary_metric")
     if not isinstance(primary, dict) or primary.get("direction") != "lower_is_better":
         errors.append("a lower-is-better primary metric must be frozen")
     return errors
 
 
 def _validate_kill(kill: Mapping[str, Any], metrics: Mapping[str, Any]) -> list[str]:
     errors: list[str] = []
     thresholds = kill.get("thresholds")
     if not isinstance(thresholds, dict):
         return ["kill criteria thresholds must be an object"]
     if thresholds.get("primary_score_gain_min") != 0.05:
         errors.append("primary score gain threshold must be 5%")
     if thresholds.get("transfer_gain_min") != 0.10:
         errors.append("transfer gain threshold must be 10%")
     if thresholds.get("hard_constraint_violation_rate_max") != 0.01:
         errors.append("hard constraint violation maximum must be 1%")
     if thresholds.get("critical_task_regression_max") != 0.05:
         errors.append("critical task regression maximum must be 5%")
     if thresholds.get("minimum_directionally_stable_seeds") != 3:
         errors.append("seed stability must require at least three seeds")
     if kill.get("insufficient_power_result") != "INCONCLUSIVE":
         errors.append("insufficient power must resolve to INCONCLUSIVE")
     if kill.get("primary_metric_id") != metrics.get("primary_metric", {}).get("id"):
         errors.append("kill criteria and metrics primary ids differ")
     return errors
 
 
 def _validate_claims(document: Mapping[str, Any]) -> list[str]:
     errors = validate_declared_claims(document.get("allowed_claims", []))
     if errors:
         return [f"claim not allowlisted: {claim}" for claim in errors]
     if document.get("foundation_status") != "FOUNDATION_EVIDENCE_INSUFFICIENT":
         errors.append("claims policy must state FOUNDATION_EVIDENCE_INSUFFICIENT")
     if document.get("action_status") != "ACTION_CONDITIONING_NOT_IDENTIFIABLE":
         errors.append("claims policy must state ACTION_CONDITIONING_NOT_IDENTIFIABLE")
     return errors
 
 
 def _validate_cross_document(documents: Mapping[str, Mapping[str, Any]]) -> list[str]:
