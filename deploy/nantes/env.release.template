# Modèle du fichier d'environnement de release. Copier en deploy/nantes/.env.release (NON versionné, droits 600)
# et remplacer chaque valeur REPLACE_ME par un secret propre à l'établissement (≥ 24 caractères aléatoires).
# scripts/deploy/check_release.py --env deploy/nantes/.env.release refuse les valeurs de ce modèle et les
# mots de passe de développement.
RELEASE_TAG=REPLACE_ME
LOG_LEVEL=INFO

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=carepredict
POSTGRES_USER=carepredict
POSTGRES_PASSWORD=REPLACE_ME
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=carepredict
TIMESCALE_USER=carepredict
TIMESCALE_PASSWORD=REPLACE_ME

DAGSTER_POSTGRES_HOST=dagster-postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=REPLACE_ME
DAGSTER_HOME=/opt/dagster/dagster_home

REDIS_PASSWORD=REPLACE_ME
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
MLFLOW_TRACKING_URI=http://mlflow:5000
