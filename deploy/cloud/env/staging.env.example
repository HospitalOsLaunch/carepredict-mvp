# HospitalOS — environnement « staging ». Copier sur le serveur en /opt/hospitalos/staging/.env (droits 600,
# jamais versionné) et remplacer chaque REPLACE_ME. Contrôle :
#   python scripts/deploy/check_release.py --profile cloud --env /opt/hospitalos/staging/.env
APP_ENV=staging
DOMAIN=staging.REPLACE_ME
ACME_EMAIL=REPLACE_ME
ROBOTS_TAG=noindex, nofollow

# Images (GHCR). IMAGE_TAG est réécrit par deploy/cloud/deploy.sh à chaque déploiement.
REGISTRY=ghcr.io/hospitaloslaunch
IMAGE_TAG=REPLACE_ME

# Emails (invitations, réinitialisation) : fournisseur SMTP transactionnel
EMAIL_BACKEND=smtp
EMAIL_FROM=HospitalOS <no-reply@REPLACE_ME>
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_STARTTLS=true

# Pas de mesure d'audience en staging (la plateforme ne l'expose qu'en production).
