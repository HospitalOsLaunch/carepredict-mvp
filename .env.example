# Runtime
COMPOSE_PROJECT_NAME=carepredict_mvp
PYTHONPATH=/app
LOG_LEVEL=INFO

# Redpanda / Kafka-compatible streaming
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_SIH_RAW=sih.raw
KAFKA_TOPIC_FHIR_RAW=fhir.raw
KAFKA_TOPIC_CSV_RAW=csv.raw
KAFKA_TOPIC_CANONICAL_EVENTS=canonical.events

# TimescaleDB
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=carepredict
POSTGRES_USER=carepredict
POSTGRES_PASSWORD=carepredict_dev_password
DATABASE_URL=postgresql://carepredict:carepredict_dev_password@timescaledb:5432/carepredict
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=carepredict
TIMESCALE_USER=carepredict
TIMESCALE_PASSWORD=carepredict_dev_password

# Dagster metadata database
DAGSTER_POSTGRES_HOST=dagster-postgres
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster_dev_password
DAGSTER_HOME=/opt/dagster/dagster_home

# Feast
FEAST_PROJECT=carepredict
FEAST_REGISTRY_PATH=/app/services/feature_pipeline/feast/registry.db
FEAST_REDIS_HOST=redis
FEAST_REDIS_PORT=6379
FEAST_ONLINE_STORE_URL=redis:6379

# dbt
DBT_PROFILES_DIR=/app/services/feature_pipeline/dbt
DBT_TARGET=dev

# MLflow, declared for pass 2
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# Synthetic data
SYNTHETIC_PATIENT_COUNT=1000
SYNTHETIC_MONTHS=24
SYNTHETIC_START_DATE=2024-01-01
SYNTHETIC_OUTPUT_DIR=/app/data/generated
MIMIC_DEMO_DIR=/app/data/generated/mimic-demo
