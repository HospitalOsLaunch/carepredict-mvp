{
  "$defs": {
    "StaffCapacity": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "required": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "IDE",
              "AS"
            ]
          },
          "title": "Required",
          "type": "object"
        },
        "staffed_beds": {
          "minimum": 0,
          "title": "Staffed Beds",
          "type": "integer"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "staffed_beds",
        "required"
      ],
      "title": "StaffCapacity",
      "type": "object"
    },
    "StaffShift": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "skill": {
          "enum": [
            "IDE",
            "AS"
          ],
          "title": "Skill",
          "type": "string"
        },
        "staff_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,159}$",
          "title": "Staff Id",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "status": {
          "enum": [
            "scheduled",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "staff_id",
        "skill",
        "start",
        "end",
        "status"
      ],
      "title": "StaffShift",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "capacity": {
      "items": {
        "$ref": "#/$defs/StaffCapacity"
      },
      "title": "Capacity",
      "type": "array"
    },
    "covers_from": {
      "format": "date-time",
      "title": "Covers From",
      "type": "string"
    },
    "covers_until": {
      "format": "date-time",
      "title": "Covers Until",
      "type": "string"
    },
    "hospital_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,159}$",
      "title": "Hospital Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "kind": {
      "const": "roster",
      "default": "roster",
      "title": "Kind",
      "type": "string"
    },
    "provenance": {
      "default": "hospital_export",
      "enum": [
        "synthetic",
        "hospital_export"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "UNIT_OUTLOOK_1",
      "default": "UNIT_OUTLOOK_1",
      "title": "Schema Version",
      "type": "string"
    },
    "shifts": {
      "items": {
        "$ref": "#/$defs/StaffShift"
      },
      "title": "Shifts",
      "type": "array"
    },
    "source": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,159}$",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "outage",
        "partial"
      ],
      "title": "Status",
      "type": "string"
    },
    "synced_at": {
      "format": "date-time",
      "title": "Synced At",
      "type": "string"
    },
    "timezone": {
      "const": "Europe/Paris",
      "default": "Europe/Paris",
      "title": "Timezone",
      "type": "string"
    },
    "unit_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,159}$",
      "title": "Unit Id",
      "type": "string"
    },
    "validated": {
      "title": "Validated",
      "type": "boolean"
    }
  },
  "required": [
    "hospital_id",
    "unit_id",
    "source",
    "revision",
    "issued_at",
    "available_at",
    "synced_at",
    "covers_from",
    "covers_until",
    "status",
    "validated",
    "shifts",
    "capacity"
  ],
  "title": "Roster",
  "type": "object"
}
